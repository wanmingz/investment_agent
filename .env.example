# --- Gemini (recommended) ---
# Create a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# Free tier ~20 req/day for flash-lite; full pipeline ~5 req/run
# RESUME_CHECKPOINT=1
# LLM_MAX_RETRIES_ON_429=2

# Gemini OpenAI-compatible endpoint (usually no change needed)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Or OpenAI / other compatible API ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Optional: market focus
MARKET_REGION=global

# Optional: news ingest (Finnhub — free tier at https://finnhub.io/)
# Without this key, TickerTick curated feed is still used.
FINNHUB_API_KEY=
NEWS_MAX_ARTICLES=40
RAG_TOP_K=12

# Optional: max theme tickers for structured fundamentals (yfinance)
FUNDAMENTALS_MAX_TICKERS=8
