# --- Gemini (recommended) ---
# Create a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# Free tier ~20 req/day for flash-lite; full pipeline ~3 LLM calls/run
# RESUME_CHECKPOINT=1
# LLM_MAX_RETRIES_ON_429=2

# Gemini OpenAI-compatible endpoint (usually no change needed)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Or OpenAI / other compatible API ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# --- Groq (OpenAI-compatible, generous free tier) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
# Groq on-demand ~12k TPM/request — defaults auto-cap news RAG (RAG_TOP_K=8).
# If Narrative fails with 413 / request too large, lower further:
# RAG_TOP_K=6
# RAG_SUMMARY_MAX_CHARS=200
# RAG_CONTEXT_MAX_CHARS=4000
# NEWS_MAX_ARTICLES=30
# RESUME_CHECKPOINT=1

# --- OpenRouter free models (e.g. Llama 3.3 70B) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Free tier ~50 req/day, ~20/min; full pipeline ~3 LLM calls/run.
# Agents run sequentially by default (LLM_PARALLEL_AGENTS=0).
# RESUME_CHECKPOINT=1
# LLM_AGENT_DELAY_SECONDS=5
# LLM_MAX_RETRIES_ON_429=4

# Optional: market focus
MARKET_REGION=global

# Optional: news ingest (Finnhub — free tier at https://finnhub.io/)
# Without this key, TickerTick curated feed is still used.
FINNHUB_API_KEY=
NEWS_MAX_ARTICLES=40
RAG_TOP_K=12

# Optional: max theme tickers for structured fundamentals (yfinance)
FUNDAMENTALS_MAX_TICKERS=8
